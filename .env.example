# ApplyPilot — local, single-user configuration.
# Copy to `.env` and fill in. NEVER commit `.env` (it is gitignored).
# PII and secrets stay on this machine only.

# --- LLM provider (default: bundled — built in, local, FREE) -----------------
# No install, no daemon, no key: the "embedded" provider runs the redistributable
# bundled models in-process (chat: qwen2.5-1.5b-instruct; embeddings:
# nomic-embed-text-v1.5). Download them once with `npm run models:download` or
# the Settings screen. The deterministic anti-fabrication gate runs WITHOUT any
# LLM; the model never overrides it.
# APPLYPILOT_LLM_PROVIDER=embedded
# APPLYPILOT_MODELS_DIR=   # where the GGUF files live (default: <data dir>/models)

# Power users: point at your own local server instead (Ollama, vLLM, LM Studio):
# APPLYPILOT_LLM_PROVIDER=ollama
# APPLYPILOT_LLM_BASE_URL=http://localhost:11434/v1
# APPLYPILOT_LLM_MODEL=qwen2.5:7b
# APPLYPILOT_LLM_API_KEY=   # only for openai-compatible servers that require auth
# Per-request LLM timeout (ms). A stalled local model aborts and falls back to the deterministic
# path instead of hanging. Default 60000. Lower it on slow CPU-only hosts.
# APPLYPILOT_LLM_TIMEOUT_MS=60000

# --- Embeddings — semantic résumé <-> job-description matching ----------------
# Default: the bundled in-process embedding model (nomic-embed-text-v1.5).
# Setting either var below opts into an OpenAI-compatible HTTP endpoint instead.
# If no embedding model is available, matching falls back to lexical scoring.
# APPLYPILOT_EMBED_MODEL=nomic-embed-text
# APPLYPILOT_EMBED_BASE_URL=http://localhost:11434/v1
# APPLYPILOT_EMBED_API_KEY=

# Optional: Anthropic Claude (cloud, paid) — set provider + key instead:
# APPLYPILOT_LLM_PROVIDER=anthropic
# APPLYPILOT_LLM_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# APPLYPILOT_LLM_MODEL=claude-sonnet-4-6

# Legacy Anthropic env vars still work (auto-selects anthropic when a key is set):
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Job-alert email ingestion (optional; local files only) ------------------
# ApplyPilot can fold LinkedIn/Indeed job-alert emails into discovery. It reads
# them ONLY as files you export yourself — no Gmail login, no stored tokens, no
# IMAP. Set up saved-search alerts on LinkedIn/Indeed, then drop each alert email
# (saved as .eml, or a .mbox export) into this folder. Only messages from the
# known LinkedIn/Indeed alert senders are parsed; everything else is ignored, and
# only job metadata + links are kept — never the email body. Unset = off.
# APPLYPILOT_ALERT_MAIL_DIR=./alert-mail

# --- Local datastore ---------------------------------------------------------
# SQLite file holding the profile + facts ledger. Lives under /data (gitignored).
APPLYPILOT_DB_PATH=./data/applypilot.sqlite

# --- Encryption at rest (optional but recommended) ---------------------------
# 32-byte key, hex (64 chars) or base64. If set, sensitive PII columns
# (self-ID, contact, dynamic answers) are encrypted at rest with AES-256-GCM.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APPLYPILOT_ENCRYPTION_KEY=

# --- Network access (mobile companion) ---------------------------------------
# API/dashboard port for Electron and browser-first web mode.
APPLYPILOT_API_PORT=5179

# DEFAULT (unset) = bind 127.0.0.1 ONLY: nothing is reachable off this machine.
# Opt in to mobile by exposing the API to your private Tailscale network:
#   tailscale  -> auto-detect this machine's 100.x tailnet IP (loopback kept too)
#   100.x.y.z  -> an explicit tailnet IP
# Binding all interfaces is refused unless APPLYPILOT_ALLOW_ALL_INTERFACES=1.
APPLYPILOT_BIND_HOST=

# Optional app-layer auth. Leave blank for loopback-only. Set a long random token
# when using browser-first web mode from another device; the dashboard will prompt
# for it and send `Authorization: Bearer <token>` on /api/*.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APPLYPILOT_AUTH_TOKEN=

# Optional extra browser origins allowed to call the API cross-origin (CSV).
# localhost and tailnet (100.x) origins are always allowed; there is no blanket "*".
APPLYPILOT_ALLOWED_ORIGINS=

# Escape hatch: set to 1 to permit binding 0.0.0.0 (LAN/public). Only with a token + TLS.
APPLYPILOT_ALLOW_ALL_INTERFACES=
