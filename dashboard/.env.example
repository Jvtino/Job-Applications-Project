# Firebase web app config. Paste these into Vercel Project Settings -> Environment Variables,
# and optionally into dashboard/.env.local when testing cloud sync locally.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Optional: when true, a failed local API load can show a signed-in user's cloud snapshot.
# Keep false/blank while debugging local discovery and automation.
VITE_ENABLE_CLOUD_FALLBACK=

# Hosted read-only "web copy" backend base URL. Leave BLANK to use the same-origin default
# (/api/backend — the Vercel serverless function in this repo). Set only if the backend is
# hosted on a separate domain, e.g. https://api.applypilot.app. Public value (never a secret).
VITE_APPLYPILOT_SNAPSHOT_BASE=
